# Secrets. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Downloads and derived rasters. Recreate them with the scripts in ml/scripts/.
data/raw/
data/processed/

# GeoTIFF rasters (large). Rebuild with apply_susceptibility_map.py / assessment --save.
# Committed in git (not ignored): susceptibility_lgbm.txt, susceptibility_calibration.json,
# metrics.json, feature_importance.json, model_b_validation.json, geo_validation/*.
ml/artifacts/*.tif
!ml/artifacts/susceptibility.tif
ml/artifacts/packs/*/*.tif
ml/artifacts/hills/
# Event-time production classifier artifacts are versioned when generated. Keep the
# backtest report and raw variant directories out of Git unless explicitly promoted.
ml/artifacts/risk_backtest_report.json
# The selected avalanche deployment files live at ml/artifacts/avalanche/. Alternate
# training runs remain in ignored subdirectories such as nwac_gefs_transferable_v2/.
ml/artifacts/avalanche/*/

# Rendered map tiles. Recreate with ml/scripts/render_tiles.py.
backend/tiles/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS and editors
.DS_Store

# Claude Code agent worktrees (isolated checkouts). Never commit them.
.claude/worktrees/

# MapLibre worker copies, written by frontend/scripts/copy-maplibre-worker.mjs on npm install
frontend/public/maplibre/

# design-sync (Claude Design): staged converter, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
message.txt
