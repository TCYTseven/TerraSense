# Copy to .env at repo root: cp .env.example .env (never commit .env)

# LOCAL = machine Postgres; PROD = Tiger Cloud (TimescaleDB, Postgres-compatible).
DB=PROD
DATABASE_URL_LOCAL=postgresql://USER@localhost:5432/terrasense
# From Tiger Cloud service connection string (tsdbadmin user, sslmode=require).
DATABASE_URL_PROD=postgresql://tsdbadmin:PASSWORD@SERVICE_ID.auxugra4eo.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Optional legacy override: if set alone, used when the matching DATABASE_URL_* is empty.
# DATABASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Unused: the home globe draws every peak from GET /mountains. Kept so old .env files do not break builds.
NEXT_PUBLIC_GLOBE_MOUNTAIN_LIMIT=50
# mountainstest: spaced worldwide sample (data/seed/mountains_test.json).
# reseed: full dump in data/seed/mountains.json (after --write-seed). Restart the API after changing.
SEED_MODE=mountainstest
CORS_ORIGINS=

NEXT_PUBLIC_MAPBOX_TOKEN=
OPEN_METEO_FIXTURE=

# Production landslide classifier settings. The classifier abstains when forecast/data quality is insufficient.
LANDSLIDE_FORECAST_PROVIDER=open-meteo-compatibility
LANDSLIDE_TARGET_PRECISION=0.85
LANDSLIDE_MIN_DATA_QUALITY=0.80
LANDSLIDE_OOD_THRESHOLD=0.35
LANDSLIDE_ABSTENTION_BAND=0.05
# Headline/API floor; calibrated_probability and state decisions remain exact. Values below 0.1 are clamped to 0.1.
MIN_REPORTED_HAZARD_PROBABILITY=0.10
LANDSLIDE_CELL_SIZE_M=1000
LANDSLIDE_MODEL_MODE=long-history
# Offline/source-builder feature switches. Modern mode requires SMAP; long-history uses ERA5-Land.
LANDSLIDE_USE_SMAP=true
LANDSLIDE_USE_MODIS_SNOW=true
LANDSLIDE_USE_OSM=true
LANDSLIDE_USE_GEOLOGY=false

# Avalanche classifier settings. The endpoint abstains until a calibrated avalanche artifact and
# an operational snow forecast (GFS or GEFS) are available.
AVALANCHE_FORECAST_PROVIDER=gfs
# Optional reviewed artifact directory. Leave unset to keep the endpoint fail-closed.
AVALANCHE_ARTIFACT_DIR=
AVALANCHE_TARGET_PRECISION=0.85
AVALANCHE_MIN_DATA_QUALITY=0.80
AVALANCHE_OOD_THRESHOLD=0.35
AVALANCHE_ABSTENTION_BAND=0.05
AVALANCHE_CELL_SIZE_M=1000
AVALANCHE_MIN_NEGATIVE_COVERAGE=0.80

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
# grok-4.3 pairs with GROK_REASONING_EFFORT's default of none. grok-4.7 rejects none and
# answers every call HTTP 400, so change both together or leave both blank.
GROK_MODEL=grok-4.3

LLM_ROUTER=
LLM_USE_GROK=
LLM_TIMEOUT_S=
GEMINI_THINKING_LEVEL=
GROK_REASONING_EFFORT=
GROK_API=
GEMINI_BASE_URL=
XAI_BASE_URL=
