# Copy to .env at repo root: cp .env.example .env (never commit .env)

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/terrasense
NEXT_PUBLIC_API_URL=http://localhost:8000
# Home globe marker cap (search still lists every peak). Default 50 if unset. Use 0 for no cap.
NEXT_PUBLIC_GLOBE_MOUNTAIN_LIMIT=50
# mountainstest: spaced worldwide sample (data/seed/mountains_test.json).
# reseed: full dump in data/seed/mountains.json (after --write-seed). Restart the API after changing.
SEED_MODE=mountainstest
CORS_ORIGINS=

NEXT_PUBLIC_MAPBOX_TOKEN=
OPEN_METEO_FIXTURE=
# Loaded only when Open-Meteo fails and no earlier good response is cached. Labeled "fixture" everywhere.
OPEN_METEO_FALLBACK_FIXTURE=backend/fixtures/open_meteo_storm.json
# Seconds a run's agent stage may take before it fails with a clear message. Default 180.
RUN_TIMEOUT_S=

# Production landslide classifier settings. The classifier abstains when forecast/data quality is insufficient.
LANDSLIDE_FORECAST_PROVIDER=open-meteo-compatibility
LANDSLIDE_TARGET_PRECISION=0.85
LANDSLIDE_MIN_DATA_QUALITY=0.80
LANDSLIDE_OOD_THRESHOLD=0.35
LANDSLIDE_ABSTENTION_BAND=0.05
LANDSLIDE_CELL_SIZE_M=1000
LANDSLIDE_MODEL_MODE=long-history
# Offline/source-builder feature switches. Modern mode requires SMAP; long-history uses ERA5-Land.
LANDSLIDE_USE_SMAP=true
LANDSLIDE_USE_MODIS_SNOW=true
LANDSLIDE_USE_OSM=true
LANDSLIDE_USE_GEOLOGY=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
# grok-4.3 pairs with GROK_REASONING_EFFORT's default of none. grok-4.7 rejects none and
# answers every call HTTP 400, so change both together or leave both blank.
GROK_MODEL=grok-4.3

LLM_ROUTER=
LLM_USE_GROK=
LLM_TIMEOUT_S=
GEMINI_THINKING_LEVEL=
GROK_REASONING_EFFORT=
GROK_API=
GEMINI_BASE_URL=
XAI_BASE_URL=
