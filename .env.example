# TerraSense environment. Copy to .env at the repo root and fill in values:
#   cp .env.example .env
# The API (backend/) and the Next.js app (frontend/) both read this one file.
# Never commit .env.

# Postgres on Neon or Supabase. backend/ uses it for the schema, the seed, and reads.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/terrasense

# Where the browser reaches the FastAPI service (backend/, port 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Extra browser origins the API accepts, comma-separated. Local dev needs none.
# Set it to the deployed frontend, for example https://terrasense.vercel.app
CORS_ORIGINS=

# Optional Mapbox public token (starts with pk.). Set, the mountain map shows Mapbox satellite
# imagery. Empty, it shows a light shaded relief. The 3D terrain needs no key either way.
NEXT_PUBLIC_MAPBOX_TOKEN=

# One LLM provider key for the five agents.
LLM_API_KEY=
# Model IDs from that provider. Fast: Terrain, Weather, Trail. Strong: Synthesizer, Alert Writer.
LLM_FAST_MODEL=
LLM_STRONG_MODEL=

# Discord incoming webhook for the ranger alert. Treat it like a password.
DISCORD_WEBHOOK_URL=
