# TerraSense environment. Copy to .env at the repo root and fill in values:
#   cp .env.example .env
# The API (backend/) and the Next.js app (frontend/) both read this one file.
# Never commit .env.

# Postgres on Neon or Supabase. backend/ uses it for the schema, the seed, and reads.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/terrasense

# Where the browser reaches the FastAPI service (backend/, port 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Extra browser origins the API accepts, comma-separated. Local dev needs none.
# Set it to the deployed frontend, for example https://terrasense.vercel.app
CORS_ORIGINS=

# Optional Mapbox public token (starts with pk.). Set, the mountain map shows Mapbox satellite
# imagery. Empty, it shows a light shaded relief. The 3D terrain needs no key either way.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional, for offline work: a saved Open-Meteo response to read instead of the live API, such as
# backend/fixtures/open_meteo_storm.json (a synthetic storm). Rain from it is labeled "fixture"
# everywhere it shows. Leave empty for live rain.
OPEN_METEO_FIXTURE=

# The five agents run on two LLM providers. A router in backend/app/agents/router.py picks one per
# call: Gemini Flash for fast extraction, Grok for judgment calls, and the other as the fallback.
# Either key alone works: the router sends every call to the provider that has one.
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# xAI key: https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Optional LLM settings. Defaults in brackets.
# Force every call to one provider, for testing: gemini, grok, or auto [auto].
LLM_ROUTER=
# Seconds before a model call gives up and the router tries the other provider [40].
LLM_TIMEOUT_S=
# How hard each model thinks. Lower is faster. Gemini 3.x: low, medium, high [low].
GEMINI_THINKING_LEVEL=
# Grok: low, medium, high [low].
GROK_REASONING_EFFORT=
# Grok endpoint: responses (returns reasoning summaries) or chat [responses].
GROK_API=
# API base URLs, only to go through a proxy or a local mock.
GEMINI_BASE_URL=
XAI_BASE_URL=

# Discord incoming webhook for the ranger alert. Treat it like a password.
DISCORD_WEBHOOK_URL=
